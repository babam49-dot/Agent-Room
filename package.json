{
  "name": "agentroom-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @agentroom/db generate",
    "db:migrate": "pnpm --filter @agentroom/db migrate",
    "db:seed": "pnpm --filter @agentroom/db seed",
    "db:reset": "pnpm --filter @agentroom/db reset",
    "sim": "pnpm --filter @agentroom/api sim"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.0.0"
  }
}
